# Copy this file to .env and adjust before running `docker compose up -d`.

# --- Security -----------------------------------------------------------
# Random long string used to sign admin session cookies. CHANGE THIS.
SECRET_KEY=change-this-to-a-long-random-string

# --- Admin account (created automatically on first start) ---------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# --- Public URL -----------------------------------------------------------
# Used to build the voter links (https://vot.aalto.md/<uuid>).
# Without the optional Caddy/HTTPS profile, this is whatever you expose app on.
PUBLIC_BASE_URL=https://vot.aalto.md

# How many days a voting link keeps resolving (showing "voting closed")
# after the election's end date, before it's treated as gone (HTTP 410).
LINK_GRACE_DAYS=30

# Local port the app container is published on when NOT using the Caddy profile.
APP_PORT=8000

# Domain Caddy requests a certificate for, when using: docker compose --profile https up -d
PUBLIC_DOMAIN=vot.aalto.md
