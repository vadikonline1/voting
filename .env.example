# Copy this file to .env and adjust before running `docker compose up -d`.

# --- Security -----------------------------------------------------------
# Random long string used to sign admin session cookies. CHANGE THIS.
SECRET_KEY=change-this-to-a-long-random-string

# --- Admin account (created automatically on first start) ---------------
# Simple initial credentials. The panel forces you to set a new password
# (minimum 8 characters) at the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# One-shot recovery for an existing database with a forgotten/unknown password:
# set this to true, restart the container, log in with ADMIN_PASSWORD, change the
# password in the panel, then set this back to false. The reset runs only once
# (marker file /data/.admin-reset-used).
ADMIN_RESET_PASSWORD=false

# --- Public URL -----------------------------------------------------------
# Used to build the voter links (https://vot.aalto.md/<uuid>).
# Use the public address where the app is reachable (put HTTPS in front of it yourself).
PUBLIC_BASE_URL=https://vot.aalto.md

# How many days a voting link keeps resolving (showing "voting closed")
# after the election's end date, before it's treated as gone (HTTP 410).
LINK_GRACE_DAYS=30

# Local port the app container is published on.
APP_PORT=8000

